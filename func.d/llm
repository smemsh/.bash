#

aikey ()
{
	local keyname
	local keybase=~/var/secrets/aikeys

	if (($#))
	then
		token=$(<$keybase/${1:?})
		unset ANTHROPIC_API_KEY ANTHROPIC_API_TOKEN
		if [[ ${1:?} =~ claude ]]
		then
			unset LLM_GEMINI_KEY
			export CLAUDE_CODE_OAUTH_TOKEN=$token
		else
			unset CLAUDE_CODE_OAUTH_TOKEN
			export LLM_GEMINI_KEY=$token
		fi
		keyname=$(readlink -f $keybase/$1)
	else
		if ! [[ $keyname ]]
		then
			if [[ $LLM_GEMINI_KEY ]]
			then keyname=gemini-unknown-TODO
			elif [[ $CLAUDE_CODE_OAUTH_TOKEN ]]
			then keyname=claude-unknown-TODO
			else keyname=nokey
			fi
		fi
	fi
	echo ${keyname##*/}
}

aiset ()
{
	local name cid

	cid="$(llm logs -n 1 | head -1 | field conversation: 2 | field 1)"
	[[ $cid ]] && export LLM_SMEMSH_CID="$cid"
}

aiget ()
{
	local cmd
	test -t 1 && cmd=echo || cmd=printf
	$cmd "$LLM_SMEMSH_CID"
}

ainew ()
{
	unset LLM_SMEMSH_CID
	ai "$@" || { echo "ainew failure" >&2; false; return; }
	aiset
}

aicont ()
{
	aiset
	ai "$@"
}

aismarts () { export LLM_SMEMSH_SMARTS=${1:?}; }

ai1 () { LLM_SMEMSH_SMARTS=1 ai "$@"; }
ai2 () { LLM_SMEMSH_SMARTS=2 ai "$@"; }
ai3 () { LLM_SMEMSH_SMARTS=3 ai "$@"; }
ai4 () { LLM_SMEMSH_SMARTS=4 ai "$@"; }
ai5 () { LLM_SMEMSH_SMARTS=5 ai "$@"; }

ai ()
{
	local isatty notools
	local -a args=(llm)

	test -t 1 && isatty=1 || isatty=0

	if [[ $LLM_SMEMSH_CID ]]
	then args+=(--cid $LLM_SMEMSH_CID)
	else : # bomb "use ainew or aiset" TODO guard here or proceed?
	fi

	# if gathering an extract, do not render it
	# TODO this is a hack, just always use json and act accordingly
	#
	for arg in "$@"; do
	[[ $arg == '-x' || $arg == '--xl' || $arg == '--help' ]] && isatty=0
	[[ $arg == '--schema' || $arg == '--schema-multi' ]] && notools=1
	done

	if ! [[ $LLM_GEMINI_KEY || $CLAUDE_CODE_OAUTH_TOKEN ]]
	then echo "no set aikey" >&2; false; return; fi

	declare -A models=(
		gemini_1 gemini/gemini-4-carbon
		gemini_2 gemini/gemini-4-argon
		gemini_3 gemini/gemini-4-hydrogen
		gemini_4 gemini/gemini-3.8-flash
		gemini_5 gemini/gemini-3.5-flash-lite
		claude_1 anthropic/claude-fable-5-1
		claude_2 anthropic/claude-fable-5-2
		claude_3 anthropic/claude-opus-5-5
		claude_4 anthropic/claude-sonnet-5-5
		claude_5 anthropic/claude-haiku-5-5
	)

	# default is 5, easy to hit with web_search, although unclear if this
	# even applies to GoogleSearch, have not run into it at all with
	# Gemini, but can't hurt to have this on there, if we hit 25 in
	# practice, something is probably wrong...
	#
	args+=(--chain-limit 25)

	if [[ $LLM_GEMINI_KEY ]]
	then
		modelkey=gemini_${LLM_SMEMSH_SMARTS:-1}
		args+=(
			-T GoogleSearch # server-side
			-T URLContext   # server-side
			-t system-prompt-rgemini
		)

	elif [[ $CLAUDE_CODE_OAUTH_TOKEN ]]
	then
		modelkey=claude_${LLM_SMEMSH_SMARTS:-1}
		args+=(
			-t system-prompt-rgemini-claude
		)
		# these tools cannot be used together with --schema-multi in
		# claude for some reason, the anthropic-llm does not support it
		# according to the tool output when attempting it
		# --smemsh-20261111102458
		#
		((notools)) || args+=(
			#
			# client-side via exa right now... claude supports
			# server-side with WebSearch and WebFetch tools but
			# they don't work, probably because the [server-side]
			# sandbox is only accessible from the claude cli tool
			# itself with some secret sauce TODO
			#
			-T web_search
			-T get_contents
		)
	else
		echo "aikey bogus" >&2; false; return
	fi

	args+=(-m ${models[$modelkey]})

	if ((isatty))
	then "${args[@]}" "$@" | mdrender
	else "${args[@]}" "$@"
	fi
}

mdrender ()
{
	mdformat --wrap 80 ${1:-'-'} \
	| glow -w ${COLUMNS:-0} -s ~/.config/glow/dark-nomargin.json \
	;
}
