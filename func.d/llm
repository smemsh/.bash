#

aikey ()
{
	local keyname
	local keybase=~/var/secrets/aikeys

	if (($#))
	then
		token=$(<$keybase/${1:?})
		unset ANTHROPIC_API_KEY ANTHROPIC_API_TOKEN
		if [[ ${1:?} =~ claude ]]
		then
			unset LLM_GEMINI_KEY
			export CLAUDE_CODE_OAUTH_TOKEN=$token
		else
			unset CLAUDE_CODE_OAUTH_TOKEN
			export LLM_GEMINI_KEY=$token
		fi
		keyname=$(readlink -f $keybase/$1)
	fi
	[[ $keyname ]] && echo ${keyname##*/}
}

aiset ()
{
	local name cid

	cid="$(llm logs -n 1 | head -1 | field conversation: 2 | field 1)"
	[[ $cid ]] && export LLM_SMEMSH_CID="$cid"
}

aiget ()
{
	local cmd
	test -t 1 && cmd=echo || cmd=printf
	$cmd "$LLM_SMEMSH_CID"
}

ainew ()
{
	unset LLM_SMEMSH_CID
	ai "$@" || { echo "ainew failure" >&2; false; return; }
	aiset
}

aicont ()
{
	aiset
	ai "$@"
}

aismarts () { export LLM_SMEMSH_SMARTS=${1:?}; }

ai1 () { LLM_SMEMSH_SMARTS=1 ai "$@"; }
ai2 () { LLM_SMEMSH_SMARTS=2 ai "$@"; }
ai3 () { LLM_SMEMSH_SMARTS=3 ai "$@"; }

ai ()
{
	local isatty
	local -a args=(llm)

	test -t 1 && isatty=1 || isatty=0

	if [[ $LLM_SMEMSH_CID ]]
	then args+=(--cid $LLM_SMEMSH_CID)
	else : # bomb "use ainew or aiset" TODO guard here or proceed?
	fi

	# if gathering an extract, do not render it
	# TODO this is a hack, just always use json and act accordingly
	#
	for arg in "$@"
	do [[ $arg == '-x' || $arg == '--xl' || $arg == '--help' ]] && isatty=0
	done

	if ! [[ $LLM_GEMINI_KEY || $CLAUDE_CODE_OAUTH_TOKEN ]]
	then echo "no set aikey" >&2; false; return; fi

	declare -A models=(
		gemini_1 gemini/gemini-4-argon
		gemini_2 gemini/gemini-3.8-flash
		gemini_3 gemini/gemini-3.5-flash-lite
		claude_1 anthropic/claude-fable-5-1
		claude_2 anthropic/claude-opus-5-5
		claude_3 anthropic/claude-sonnet-5-5
	)

	if [[ $LLM_GEMINI_KEY ]]
	then
		modelkey=gemini_${LLM_SMEMSH_SMARTS:-1}
		args+=(-t system-prompt-rgemini)

	elif [[ $CLAUDE_CODE_OAUTH_TOKEN ]]
	then
		modelkey=claude_${LLM_SMEMSH_SMARTS:-1}
		args+=(-t system-prompt-rgemini-claude)
	else
		echo "aikey bogus" >&2; false; return
	fi

	args+=(-m ${models[$modelkey]})

	if ((isatty))
	then "${args[@]}" "$@" \
		| mdformat --wrap 80 - \
		| glow -w 0 -s ~/.config/glow/dark-nomargin.json \
		;
	else "${args[@]}" "$@"
	fi
}
